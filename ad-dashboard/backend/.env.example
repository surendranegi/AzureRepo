# Copy this file to .env and fill in values. Never commit .env to source control.

# Node environment
NODE_ENV=production

# Port the backend listens on (IIS reverse-proxies to this)
PORT=3001

# Absolute path to the PowerShell script repository on the server
SCRIPT_ROOT=D:\ADScripts

# Absolute path for the SQLite database file
DB_PATH=D:\ADDashboard\data\ad-dashboard.db

# Absolute path for log files
LOG_DIR=D:\ADDashboard\logs

# ─── Service account for DC connections ──────────────────────────────────────
# The Node.js process runs AS this Windows account (set via IIS App Pool identity
# or NSSM service logon). Its Kerberos ticket is used automatically by WinRM
# (Invoke-Command). No password is stored here — configure it in IIS/NSSM only.
#
# Requirements for this account:
#   - Member of "Remote Management Users" on each target DC
#   - NOT a member of Domain Admins (least-privilege)
#   - Granted only the AD permissions the scripts actually need
#     (e.g. "Reset Password" on the Users OU for password scripts)
#
# For reference only (not read by the app):
SERVICE_ACCOUNT=CORP\svc-addashboard

# ─── Claude API key ───────────────────────────────────────────────────────────
# Used only for AI script analysis (script text only, no AD data sent)
ANTHROPIC_API_KEY=sk-ant-...

# PowerShell execution timeout in milliseconds (default 60s)
PS_TIMEOUT_MS=60000

# CORS allowed origins for development (comma-separated). Not needed in production.
ALLOWED_ORIGINS=http://localhost:3000

# Development only — username to use when Windows Auth header is absent
# DEV_USER=CORP\yourname
